<?xml version="1.0" encoding="utf-8"?>
<!--
    Firebase reads its project from these strings by name when the app starts
    (FirebaseOptions.fromResource), so no code references them: resource shrinking could otherwise
    drop them, and lint reports them as unused. build.gradle.kts generates them from
    app/google-services.json.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@string/google_app_id,@string/google_api_key,@string/project_id,@string/gcm_defaultSenderId" />
