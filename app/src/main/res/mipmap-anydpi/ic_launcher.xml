<?xml version="1.0" encoding="utf-8"?>
<!--
    The launcher icon, as separate layers so the launcher can mask it to whatever shape the device
    uses and parallax the foreground.

    The monochrome layer is what Android 13+ themed icons draw; without it, Killit would be the one
    icon on the home screen that ignores the user's wallpaper colours. Generated along with the
    other densities by tools/icon/generate.py.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
