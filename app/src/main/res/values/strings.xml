    <string name="home_release_now_confirm_body">Every blocked app will be unblocked first, then Killit gives up its Device Owner privileges. Re-provisioning needs a factory reset. Continue?</string>

    <!-- Provisioning -->
    <string name="prov_section_title">Turn on protection</string>
    <string name="prov_precondition">All three methods need a device with no accounts signed in and no existing device owner. On a device already in use that means a factory reset.</string>

    <string name="prov_adb_name">1. Computer (adb)</string>
    <string name="prov_adb_short">Use a USB cable</string>
    <string name="prov_adb_intro">Connect this phone to a computer to turn on protection.</string>
    <string name="prov_adb_step_1">Turn on USB debugging in Developer options, then plug this phone into a computer.</string>
    <string name="prov_adb_step_2">Run this command on the computer:</string>
    <string name="prov_adb_step_3">When it prints Success, come back here and tap Refresh status.</string>

    <string name="prov_shizuku_name">2. Shizuku app</string>
    <string name="prov_shizuku_short">Use another app, no computer</string>
    <string name="prov_shizuku_intro">Use the free Shizuku app to turn on protection.</string>
    <string name="prov_shizuku_step_1">Install Shizuku and start it over wireless debugging.</string>
    <string name="prov_shizuku_step_2">Come back here and tap the button below.</string>
    <string name="prov_shizuku_step_3">Grant Shizuku permission when it asks.</string>
    <string name="prov_shizuku_run">Set Device Owner via Shizuku</string>
    <string name="prov_shizuku_not_running">Shizuku is not running. Start it first.</string>
    <string name="prov_shizuku_old">This Shizuku version is too old. Update it.</string>
    <string name="prov_shizuku_denied">Shizuku permission denied.</string>
    <string name="prov_shizuku_working">Asking Shizuku…</string>

    <string name="prov_qr_name">3. QR code</string>
    <string name="prov_qr_short">Set up from another phone</string>
    <string name="prov_qr_intro">Provision this phone from the Android setup wizard.</string>
    <string name="prov_qr_step_1">Factory reset this phone.</string>
    <string name="prov_qr_step_2">On the welcome screen, tap the same spot 6 times to open the QR scanner.</string>
    <string name="prov_qr_step_3">Scan the code from the Killit website. The phone downloads and provisions Killit in one step.</string>

