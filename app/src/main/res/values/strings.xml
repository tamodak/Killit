    <!-- Hardening -->
    <string name="harden_uninstall">Block uninstalling Killit</string>
    <string name="harden_uninstall_desc">Stops Killit being removed to escape the block.</string>
    <string name="harden_force_stop">Block force-stopping Killit</string>
    <string name="harden_force_stop_desc">Greys out Force stop in Settings, and blocks Clear data too on Android 13 or newer. Needs Android 11 or newer.</string>
    <string name="harden_safe_boot">Block safe mode</string>
    <string name="harden_safe_boot_desc">Safe mode would otherwise disable third-party apps on reboot.</string>
    <string name="harden_factory_reset">Block factory reset and new users</string>
    <string name="harden_factory_reset_desc">Closes the last bypass routes. adb stays available as the only way out.</string>
    <string name="harden_apps_control">Block managing apps in Settings</string>
    <string name="harden_apps_control_desc">Off by default, because it applies to every app on the device: you would not be able to uninstall, force-stop or clear data for any of them, not just the blocked ones. Killit\'s own data is already protected without it.</string>
    <string name="harden_date_time">Block changing date and time</string>
    <string name="harden_date_time_desc">The removal countdown is measured against the clock. Without this it can be skipped by moving the date forward.</string>

    <!-- Tamper recovery -->
    <string name="tamper_title">Killit data was cleared</string>
    <string name="tamper_body">Apps are still blocked, but the passkey is gone, so Killit cannot verify who you are. It will not unblock anything in this state.\n\nTo recover, remove Killit as Device Owner from a computer. That releases every blocked app:</string>

    <!-- Provisioning success -->
    <string name="compliance_title">Killit is ready</string>
    <string name="compliance_body">Killit is now the Device Owner of this device.</string>
    <string name="compliance_continue">Continue</string>
