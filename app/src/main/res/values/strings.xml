<!--
    Every user-visible string in the app.

    Grouped by the screen that shows it, in roughly the order a user meets them. Killit is not
    translated yet, so this is the only values/ folder — but the strings live here rather than in
    code so that adding a language later is a matter of adding a folder, not rewriting the screens.

    One exception is documented rather than hidden: ui/Durations.kt builds its countdowns ("2d 4h")
    in code, so those unit letters are not localisable.
-->
<resources>
    <string name="app_name">Killit</string>

    <!--
        Countdown formats, used by ui/Durations.kt. Whole formats rather than bare unit letters, so
        a language that puts the unit before the number, or needs no space, can say so here.
    -->
    <string name="duration_d_h">%1$dd %2$dh</string>
    <string name="duration_h_m">%1$dh %2$dm</string>
    <string name="duration_m_s">%1$dm %2$ds</string>
    <string name="duration_s">%1$ds</string>

