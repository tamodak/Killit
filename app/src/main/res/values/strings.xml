    <string name="home_manage_apps">Choose apps to block</string>
    <string name="home_manage_apps_locked">Set up below first</string>
    <string name="home_change_passkey">Change passkey</string>
    <string name="home_language">Language</string>
    <string name="language_system">System default</string>
    <string name="home_hardening">Tamper protection</string>
    <string name="home_release">Unblock all &amp; remove admin</string>
    <string name="home_release_confirm_title">Start the waiting period?</string>
    <string name="home_release_confirm_body">Removing Killit is not immediate. Pressing this starts a countdown; only once it has finished can the apps be unblocked and Killit give up Device Owner. You can cancel at any point during the wait.</string>
    <string name="home_release_start">Start the countdown</string>
    <string name="home_release_pending_title">Removal pending</string>
    <string name="home_release_pending_body">Killit can be removed in %1$s. Until then everything stays blocked.</string>
    <string name="home_release_cancel">Cancel removal</string>
    <string name="home_release_ready_title">Ready to remove</string>
