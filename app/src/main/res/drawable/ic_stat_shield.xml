<?xml version="1.0" encoding="utf-8"?>
<!--
    Status-bar icon for Killit's notifications: KillitIcons.Shield drawn the same way as the in-app
    icons (a 2-unit stroke with square caps and mitred joins). The status bar draws only the alpha
    channel, so the colour here does not matter.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M12,2L20,5V11C20,17 16.5,20.5 12,22C7.5,20.5 4,17 4,11V5Z"
        android:strokeWidth="2"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="square"
        android:strokeLineJoin="miter"
        android:strokeMiterLimit="4" />
</vector>
