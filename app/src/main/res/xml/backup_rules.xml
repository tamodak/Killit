<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto-backup rules for API 30 and below.

    Empty on purpose, and inert in practice: the manifest sets android:allowBackup="false", so
    nothing here is ever consulted. The file exists because android:fullBackupContent points at it,
    and the attribute is kept so that turning backup on later is a one-line change made deliberately
    rather than by deleting a reference.

    Nothing in Killit should ever be backed up. The credential record carries the lockout counters,
    so restoring an older copy would roll back failed attempts; and on a different handset it would
    describe a device owner and a blocklist that are not there.

    See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
